[Unit]
Description=TuxCut-NG ARP daemon
Documentation=https://github.com/tuxcut-ng
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/tuxcut-ng/server/tuxcutd.py
WorkingDirectory=/opt/tuxcut-ng/server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# Allow raw socket access
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
